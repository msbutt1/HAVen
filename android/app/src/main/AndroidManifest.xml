<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- the sleeve connects to this phone on TCP 8765; optionally the backend on a laptop, over Wi-Fi -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- this network's address and gateway, for "Find on this Wi-Fi" -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.VibeGuard">

        <!-- standalone: the sleeve connects to this phone (its hotspot) and the phone does all the processing -->
        <activity
            android:name=".StandaloneActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- optional: use a laptop running vg-backend instead (Settings, "Use a laptop instead") -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- rotating or resizing must not reload the dashboard (it would drop the live chart history) -->
        <activity
            android:name=".DashboardActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden"
            android:exported="false" />
    </application>
</manifest>
