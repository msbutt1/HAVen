<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:importantForAccessibility="no"
                android:src="@drawable/logo_mark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/app_name"
                android:textColor="@color/foreground"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.14"
            android:text="@string/eyebrow"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:accessibilityHeading="true"
            android:text="@string/headline"
            android:textColor="@color/foreground"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            style="@style/Body"
            android:layout_marginTop="8dp"
            android:text="@string/intro" />

        <!-- find on this Wi-Fi -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:accessibilityHeading="true"
                android:text="@string/find_title" />

            <TextView
                style="@style/Body"
                android:text="@string/find_body" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/code"
                android:fontFamily="monospace"
                android:padding="12dp"
                android:text="@string/serve_command"
                android:textColor="@color/foreground"
                android:textIsSelectable="true"
                android:textSize="14sp" />

            <Button
                android:id="@+id/find"
                style="@style/PrimaryButton"
                android:text="@string/find" />

            <LinearLayout
                android:id="@+id/found"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- type the address -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:accessibilityHeading="true"
                android:text="@string/type_title" />

            <TextView
                style="@style/Body"
                android:text="@string/type_body" />

            <EditText
                android:id="@+id/address"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:autofillHints="none"
                android:background="@drawable/input"
                android:fontFamily="monospace"
                android:hint="@string/address_hint"
                android:imeOptions="actionGo"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:singleLine="true"
                android:textColor="@color/foreground"
                android:textColorHint="@color/muted"
                android:textSize="16sp" />

            <Button
                android:id="@+id/connect"
                style="@style/OutlineButton"
                android:text="@string/connect" />

            <TextView
                android:id="@+id/recent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="?android:attr/selectableItemBackground"
                android:minHeight="44dp"
                android:gravity="center_vertical"
                android:textColor="@color/primary"
                android:textSize="15sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:accessibilityLiveRegion="polite"
            android:background="@drawable/code"
            android:padding="14dp"
            android:textColor="@color/foreground"
            android:textSize="15sp"
            android:visibility="gone" />

        <!-- the demo, on the simulated feed -->
        <LinearLayout
            style="@style/Card"
            android:background="@drawable/demo_card">

            <TextView
                style="@style/CardTitle"
                android:accessibilityHeading="true"
                android:text="@string/demo_title" />

            <TextView
                style="@style/Body"
                android:text="@string/demo_body" />

            <Button
                android:id="@+id/demo"
                style="@style/OutlineButton"
                android:text="@string/demo" />
        </LinearLayout>

        <TextView
            style="@style/Body"
            android:layout_marginTop="20dp"
            android:text="@string/footer"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
