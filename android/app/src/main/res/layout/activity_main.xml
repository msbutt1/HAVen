<?xml version="1.0" encoding="utf-8"?>
<!-- The connect screen. It starts on its own (last laptop, then a search); one status card says what is happening;
     help and the typed address wait behind "Can't connect?". -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:importantForAccessibility="no"
                android:src="@drawable/logo_mark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/app_name"
                android:textColor="@color/foreground"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:accessibilityHeading="true"
            android:text="@string/headline"
            android:textColor="@color/foreground"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            style="@style/Body"
            android:layout_marginTop="8dp"
            android:text="@string/intro"
            android:textSize="17sp" />

        <!-- what is happening now -->
        <LinearLayout
            android:id="@+id/status_card"
            style="@style/Card"
            android:layout_marginTop="18dp"
            android:accessibilityLiveRegion="polite"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ProgressBar
                    android:id="@+id/spinner"
                    style="@android:style/Widget.Material.ProgressBar.Small"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="14dp"
                    android:indeterminateTint="@color/primary" />

                <TextView
                    android:id="@+id/status_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/foreground"
                    android:textSize="21sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/status_detail"
                style="@style/Body"
                android:layout_marginTop="8dp"
                android:textSize="17sp" />

            <LinearLayout
                android:id="@+id/found"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <Button
                android:id="@+id/find"
                style="@style/PrimaryButton"
                android:layout_height="60dp"
                android:text="@string/search_again"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- help, and the address typed by hand -->
        <Button
            android:id="@+id/help_toggle"
            style="@style/OutlineButton"
            android:layout_height="60dp"
            android:layout_marginTop="14dp"
            android:text="@string/help_show"
            android:textSize="18sp" />

        <LinearLayout
            android:id="@+id/help"
            style="@style/Card"
            android:visibility="gone">

            <TextView
                style="@style/CardTitle"
                android:accessibilityHeading="true"
                android:text="@string/help_title"
                android:textSize="19sp" />

            <TextView
                style="@style/Body"
                android:layout_marginTop="10dp"
                android:text="@string/help_steps"
                android:textColor="@color/foreground"
                android:textSize="17sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/code"
                android:fontFamily="monospace"
                android:padding="12dp"
                android:text="@string/serve_command"
                android:textColor="@color/foreground"
                android:textIsSelectable="true"
                android:textSize="15sp" />

            <TextView
                style="@style/Body"
                android:layout_marginTop="10dp"
                android:text="@string/help_network"
                android:textSize="16sp" />

            <TextView
                style="@style/CardTitle"
                android:layout_marginTop="22dp"
                android:accessibilityHeading="true"
                android:text="@string/type_title"
                android:textSize="19sp" />

            <TextView
                style="@style/Body"
                android:text="@string/type_body"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/address"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/input"
                android:fontFamily="monospace"
                android:hint="@string/address_hint"
                android:imeOptions="actionGo"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:textColor="@color/foreground"
                android:textColorHint="@color/muted"
                android:textSize="18sp" />

            <Button
                android:id="@+id/connect"
                style="@style/PrimaryButton"
                android:layout_height="60dp"
                android:text="@string/connect"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- the demo, on the simulated feed -->
        <LinearLayout
            style="@style/Card"
            android:layout_marginTop="14dp"
            android:background="@drawable/demo_card">

            <TextView
                style="@style/CardTitle"
                android:accessibilityHeading="true"
                android:text="@string/demo_title"
                android:textSize="19sp" />

            <TextView
                style="@style/Body"
                android:text="@string/demo_body"
                android:textSize="16sp" />

            <Button
                android:id="@+id/demo"
                style="@style/OutlineButton"
                android:layout_height="60dp"
                android:text="@string/demo"
                android:textSize="18sp" />
        </LinearLayout>

        <TextView
            style="@style/Body"
            android:layout_marginTop="20dp"
            android:text="@string/footer"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
